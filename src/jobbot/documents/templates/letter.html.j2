<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<meta name="author" content="{{ name }}">
<style>
  @page { size: A4; margin: 0; }
  :root {
    --fs: 11.5pt; --lh: 1.45; --pad-y: 20mm; --pad-x: 22mm; --par-gap: 9pt;
    --accent: #1f4e79; --ink: #1b1f24; --muted: #545c68;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #ffffff; }
  body {
    font-family: Arial, "Liberation Sans", Helvetica, sans-serif;
    font-size: var(--fs); line-height: var(--lh); color: var(--ink);
    font-variant-ligatures: none; font-feature-settings: "liga" 0, "clig" 0;
    hyphens: manual; -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .page { width: 210mm; padding: var(--pad-y) var(--pad-x); }
  p { margin: 0; }
  .sender { line-height: 1.35; }
  .sender .name { font-size: 1.2em; font-weight: bold; color: var(--accent); margin-bottom: 2pt; }
  .sender .line { color: var(--muted); font-size: 0.95em; }
  .sender a { color: inherit; text-decoration: none; }
  .recipient { margin: 14pt 0 0 56%; line-height: 1.35; }
  .recipient .first { font-weight: bold; }
  .date { margin: 16pt 0 0; text-align: right; }
  .subject { margin: 16pt 0 0; }
  .subject .label { font-weight: bold; }
  .greeting { margin: 16pt 0 var(--par-gap); }
  .body { margin: 0 0 var(--par-gap); text-align: justify; }
  .signature { margin: 16pt 0 0 56%; font-weight: bold; }
</style>
</head>
<body>
<div class="page">
  <div class="sender">
    <p class="name">{{ name }}</p>
{% for item in sender %}
    <p class="line">{% if item.href %}<a href="{{ item.href }}">{{ item.text }}</a>{% else %}{{ item.text }}{% endif %}</p>
{% endfor %}
  </div>
{% if recipient %}
  <div class="recipient">
{% for line in recipient %}
    <p{% if loop.first %} class="first"{% endif %}>{{ line }}</p>
{% endfor %}
  </div>
{% endif %}
  <p class="date">{{ place_date }}</p>
  <p class="subject"><span class="label">Objet :</span> {{ subject }}</p>
  <p class="greeting">{{ greeting }}</p>
{% for p in paragraphs %}
  <p class="body">{{ p }}</p>
{% endfor %}
  <p class="body">{{ closing }}</p>
  <p class="signature">{{ signature }}</p>
</div>
</body>
</html>
