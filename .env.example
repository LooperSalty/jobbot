# Copie ce fichier en .env et remplis ce que tu as. Rien n'est obligatoire : chaque module
# désactivé faute de clé est simplement ignoré (avec un message).

# France Travail (francetravail.io → créer une application → abonner "Offres d'emploi v2" et "La Bonne Boite")
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# La Bonne Alternance / API apprentissage (api.apprentissage.beta.gouv.fr → jeton gratuit)
LBA_API_TOKEN=

# Gmail : Compte Google → Sécurité → Validation en 2 étapes → "Mots de passe des applications"
# SMTP_USER = ton adresse Gmail complète, par exemple ton.adresse@gmail.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Optionnels (un commentaire ne doit jamais être sur la même ligne que la valeur)
# hunter.io — trouver/vérifier des e-mails (offre gratuite limitée)
HUNTER_API_KEY=
# Brave Search API — trouver le site web d'une entreprise
BRAVE_API_KEY=
# Adzuna — offres d'emploi agrégées (gratuit : https://developer.adzuna.com → Register → Dashboard « Application ID » et « Application Key »)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble — offres d'emploi agrégées (clé française gratuite sur demande : https://fr.jooble.org/api/about ; voir aussi jooble.org/api/about)
JOOBLE_API_KEY=
# seulement si llm.provider = anthropic
ANTHROPIC_API_KEY=
# Google Classroom de l'école : lien(s) du cours (https://classroom.google.com/c/...), séparés par des virgules
CLASSROOM_COURSE_URLS=

# Claude Code sur un serveur sans écran : jeton longue durée de ton abonnement, créé sur le PC avec « claude setup-token »
# (copié dans le .env du serveur par scripts/deploy_server.py)
CLAUDE_CODE_OAUTH_TOKEN=
# Notifications Telegram (bot) : jeton du bot et identifiant de la conversation (voir README, notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Déploiement sur un serveur Linux (scripts/deploy_server.py) : ces clés ne sont JAMAIS copiées sur le serveur
# Alias SSH (de ton ~/.ssh/config) du compte root du serveur, authentification par clé
SERVER_ROOT_HOST_ALIAS=
# Alias SSH du compte (non root) qui fera tourner jobbot, et son nom d'utilisateur
PROJECT_SSH_HOST_ALIAS=
PROJECT_USER=
# Optionnel : IP du serveur sur ton VPN (Tailscale), seulement avec --dashboard-vpn (sinon tunnel SSH)
SERVER_IP_TAILSCALE=
