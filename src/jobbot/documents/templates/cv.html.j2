<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<meta name="author" content="{{ name }}">
<style>
  /* ATS-friendly: one column, no table / grid / flex columns, no icon, no image, real text, body contact block. */
  @page { size: A4; margin: 0; }
  :root {
    /* defaults = middle of the density scale; the PDF renderer fits the page by moving along it (see _fit.py) */
    --fs: 10.5pt; --lh: 1.33; --pad-y: 12.5mm; --pad-x: 14.5mm; --sec-gap: 9pt; --item-gap: 5pt;
    --bullet-gap: 1.25pt; --name-fs: 20.5pt;
    --accent: #1f4e79; --accent-line: #b9c9de; --ink: #1b1f24; --muted: #545c68;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: #ffffff; }
  body {
    font-family: Arial, "Liberation Sans", Helvetica, sans-serif;
    font-size: var(--fs); line-height: var(--lh); color: var(--ink);
    font-variant-ligatures: none; font-feature-settings: "liga" 0, "clig" 0;
    hyphens: manual; -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .page { width: 210mm; padding: var(--pad-y) var(--pad-x); }
  p { margin: 0; }
  h1 { margin: 0; font-size: var(--name-fs); line-height: 1.1; font-weight: bold; color: var(--ink); }
  .headline { margin: 3pt 0 3pt; font-size: 1.1em; font-weight: bold; color: var(--accent); line-height: 1.25; }
  .contact { font-size: 0.9em; color: var(--muted); }
  .contact a { color: inherit; text-decoration: none; }
  .contact .ci { white-space: nowrap; }
  h2 {
    margin: var(--sec-gap) 0 3pt; padding-bottom: 1.5pt;
    font-size: 1.02em; font-weight: bold; text-transform: uppercase; color: var(--accent);
    border-bottom: 0.8pt solid var(--accent-line); line-height: 1.2;
  }
  .summary { text-align: justify; }
  .skills p { margin: 0 0 0.6pt; }
  .label { font-weight: bold; color: var(--ink); }
  .entry { margin: 0 0 var(--item-gap); break-inside: avoid; }
  .entry:last-child, .project:last-child { margin-bottom: 0; }
  .entry-title { font-weight: bold; }
  .meta { font-size: 0.93em; font-style: italic; color: var(--muted); }
  .note { font-size: 0.95em; }
  ul { margin: 1.5pt 0 0; padding-left: 12pt; }
  li { margin: 0 0 var(--bullet-gap); text-align: justify; }
  li:last-child { margin-bottom: 0; }
  li::marker { color: var(--accent); }
  .project { margin: 0 0 calc(var(--item-gap) * 0.6); text-align: justify; }
  strong { font-weight: bold; }
</style>
</head>
<body>
<div class="page">
  <header>
    <h1>{{ name }}</h1>
    <p class="headline">{{ em(headline) }}</p>
    <p class="contact">{% for c in contacts %}{% if not loop.first %} · {% endif %}<span class="ci">{% if c.href %}<a href="{{ c.href }}">{{ c.text }}</a>{% else %}{{ c.text }}{% endif %}</span>{% endfor %}</p>
  </header>
{% for s in sections %}
  <section class="{{ s.key }}">
    <h2>{{ s.title }}</h2>
{% for p in s.paragraphs %}
    <p class="summary">{{ em(p) }}</p>
{% endfor %}
{% for label, items in s.pairs %}
    <p><span class="label">{{ label }} :</span> {{ em(items) }}</p>
{% endfor %}
{% for e in s.entries %}
{% if s.key == "projects" %}
    <p class="project"><span class="entry-title">{{ e.title }}</span> — {{ em(e.note) }}</p>
{% else %}
    <div class="entry">
      <p class="entry-title">{{ em(e.title) }}</p>
{% if e.meta %}      <p class="meta">{{ e.meta }}</p>
{% endif %}
{% if e.bullets %}      <ul>
{% for b in e.bullets %}        <li>{{ em(b) }}</li>
{% endfor %}      </ul>
{% endif %}
{% if e.note %}      <p class="note">{{ em(e.note) }}</p>
{% endif %}
    </div>
{% endif %}
{% endfor %}
{% if s.inline %}
    <p>{{ em(s.inline) }}</p>
{% endif %}
  </section>
{% endfor %}
</div>
</body>
</html>
